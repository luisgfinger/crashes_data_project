@startuml
title Crashes Data Project - Component Diagram

package "Entry Point" {
  [cli.py] as cli
}

package "Pipelines (Silver)" {
  [silver/vehicles/v1/run.py] as silver_vehicles
  [silver/crashes/v1/run.py] as silver_crashes
}

package "Config" {
  [config.py] as config
}

package "Utils" {
  [io_utils.py] as io
}

package "DQ (Rules)" {
  [dq.py\n(silver/vehicles/v1)] as dq_vehicles
  [dq.py\n(silver/crashes/v1)] as dq_crashes
}

package "Metrics" {
  [metrics.py] as metrics_mod
}

package "Data (Artifacts)" {
  [Bronze Data\n(CSV Files)] as bronze

  [Silver Vehicles Parquet\n(partitioned by run_date)] as silver_vehicles_data
  [Silver Crashes Parquet\n(partitioned by crash_year)] as silver_crashes_data

  [Silver Quarantine\n(per run folder)] as quarantine

  [Metrics CSV\n(per run folder)] as metrics_out
}

' ---- CLI dispatch ----
cli --> silver_vehicles : dispatches run()
cli --> silver_crashes : dispatches run()

' ---- Shared dependencies ----
silver_vehicles --> config : resolve paths
silver_vehicles --> io : find/read/write helpers
silver_vehicles --> dq_vehicles : apply DQ rules
silver_vehicles --> metrics_mod : write metrics.csv

silver_crashes --> config : resolve paths
silver_crashes --> io : find/read/write helpers
silver_crashes --> dq_crashes : apply DQ rules
silver_crashes --> metrics_mod : write metrics.csv

' ---- Data flow ----
bronze --> silver_vehicles : input
bronze --> silver_crashes : input (can be derived)

silver_vehicles --> silver_vehicles_data : output (clean)
silver_crashes --> silver_crashes_data : output (clean)

silver_vehicles --> quarantine : output (quarantine)
silver_crashes --> quarantine : output (quarantine)

silver_vehicles --> metrics_out : output (metrics)
silver_crashes --> metrics_out : output (metrics)

@enduml