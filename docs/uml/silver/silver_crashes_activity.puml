@startuml
title Crashes Data Project - Silver Crashes v1 Pipeline (Activity Diagram)

start

:Load config paths;
:Resolve input dataset path (Bronze);
:Find latest Bronze CSV;

if (CSV found?) then (yes)
  :Read CSV into DataFrame (dtype=string);

  :Assert required columns exist;
  :Select crash entity columns;
  :Rename columns to snake_case;
  :Trim string fields;

  :Cast types (unique_id, collision_id);
  :Parse crash_date (to datetime, errors=coerce);
  :Normalize crash_time (HH:MM / HH:MM:SS);
  :Derive crash_year from crash_date;

  :Apply data quality rules (DQ - crashes);
  note right
    DQ produces:
    - clean_df
    - quarantine_df
    - discard_df (optional)
    - metrics_summary
    - metrics_by_reason
    - run_date
  end note

  if (dry_run?) then (yes)
    :Skip writes;
    stop
  else (no)
  endif

  :Write Silver CLEAN parquet\n(partitioned by crash_year);

  if (Has quarantine rows?) then (yes)
    :Write QUARANTINE parquet\n(to run_date folder);
  else (no)
    :Skip QUARANTINE write;
  endif

  :Write METRICS CSV\n(to run_date folder);

  stop
else (no)
  :Fail with "No input file found";
  stop
endif

@enduml