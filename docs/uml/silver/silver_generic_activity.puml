@startuml
title Crashes Data Project - Silver Pipeline (Generic Activity Diagram)

start

:Load config paths;
:Resolve input dataset path (Bronze);
:Find latest Bronze CSV;

if (CSV found?) then (yes)
  :Read CSV into DataFrame (dtype=string);

  :Assert required columns exist (schema contract);
  :Select target columns;
  :Rename columns to snake_case;
  :Trim string fields;

  :Type casting / parsing (dataset-specific);
  :Derived columns (dataset-specific);

  :Apply data quality rules (DQ);
  note right
    DQ produces:
    - clean_df
    - quarantine_df
    - discard_df (optional)
    - metrics_summary
    - metrics_by_reason
    - run_date
  end note

  if (dry_run?) then (yes)
    :Skip writes;
    stop
  else (no)
  endif

  :Write Silver CLEAN parquet\n(partitioned by configured partition column);

  if (Has quarantine rows?) then (yes)
    :Write QUARANTINE parquet\n(to run_date folder);
  else (no)
    :Skip QUARANTINE write;
  endif

  :Write METRICS CSV\n(to run_date folder);

  stop
else (no)
  :Fail with "No input file found";
  stop
endif

@enduml